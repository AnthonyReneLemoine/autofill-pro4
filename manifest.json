{
  "manifest_version": 3,
  "name": "AutoFill Pro – Jean Dupont",
  "version": "1.2.0",
  "description": "Remplissage automatique de formulaires + bibliothèque de snippets via clic droit.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoFill Pro"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["snippets.txt"],
      "matches": ["<all_urls>"]
    }
  ]
}
